# EcoControl - exemplo de variáveis para execução local com Docker Compose.
# Copie para .env e substitua os valores localmente. Não versione o .env.

# Oracle local
ORACLE_SYS_PASSWORD=CHANGE_ME
APP_DB_USER=ecocontrol
APP_DB_PASSWORD=CHANGE_ME

# Basic Authentication da API
BASIC_AUTH_ADMIN_USER=admin
BASIC_AUTH_ADMIN_PASSWORD=CHANGE_ME
BASIC_AUTH_VIEWER_USER=viewer
BASIC_AUTH_VIEWER_PASSWORD=CHANGE_ME
